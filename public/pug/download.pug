doctype html
html(lang='en')
  head
    include partials/head
    include partials/head_custom
  body.page-download
    include partials/window
    +window('Transfer', 'Click a file to download it')
      #download
    include partials/footer
    script(src=appUrl + '/common.js')
    //- wizard: translations and the file list, so the app renders without fetching them
    script!= 'PSITRANSFER_PRELOAD = ' + preload + ';'
    script(src=appUrl + '/download.js')
