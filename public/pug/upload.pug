doctype html
html(lang='en')
  head
    include partials/head
    include partials/head_custom
    //- wizard: fetch the app's JSON in parallel with its scripts instead of after them
    link(href='lang.json' rel='preload' as='fetch' crossorigin)
    link(href='config.json' rel='preload' as='fetch' crossorigin)
  body.page-upload
    #dropHelper
    include partials/window
    +window('Transfer', 'Drop files anywhere on this page to add them')
      #upload
    include partials/footer
    script(src=appUrl + '/common.js')
    script PSITRANSFER_UPLOAD_PATH = '#{uploadAppPath}';
    script(src=appUrl + '/upload.js')
