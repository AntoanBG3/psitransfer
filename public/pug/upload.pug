doctype html
html(lang='en')
  head
    include partials/head
    include partials/head_custom
  body.page-upload
    #dropHelper
    include partials/window
    +window('Transfer', 'Drop files anywhere on this page to add them')
      #upload
    include partials/footer
    script(src=appUrl + '/common.js')
    script PSITRANSFER_UPLOAD_PATH = '#{uploadAppPath}';
    //- wizard: translations and the first config answer, so the app renders without fetching them
    script!= 'PSITRANSFER_PRELOAD = ' + preload + ';'
    script(src=appUrl + '/upload.js')
