base(href=baseUrl)
meta(charset='utf-8')
title Transfer
//- wizard: assetsUrl/appUrl carry a content hash and are cached for a year (lib/assetVersion.js)
link(href=assetsUrl + '/icon.svg' rel='icon' type='image/svg+xml')
link(href=assetsUrl + '/icon-32.png' rel='icon' type='image/png' sizes='32x32')
link(href=assetsUrl + '/apple-touch-icon.png' rel='apple-touch-icon')
meta(name='apple-mobile-web-app-title' content='Transfer')
meta(name='viewport' content='width=device-width, initial-scale=1')
meta(name='robots' content='noindex,nofollow')
meta(name='theme-color' content='#008080')
link(href=assetsUrl + '/98/98.css' rel='stylesheet')
link(href=assetsUrl + '/styles.css' rel='stylesheet')
//- fonts would otherwise wait for 98.css to download and parse
link(href=assetsUrl + '/98/ms_sans_serif.woff2' rel='preload' as='font' type='font/woff2' crossorigin)
link(href=assetsUrl + '/98/ms_sans_serif_bold.woff2' rel='preload' as='font' type='font/woff2' crossorigin)
