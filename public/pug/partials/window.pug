//- wizard: the page is one Win98 window; the app mounts inside its body
mixin window(title, status)
  main.window#main-window
    .title-bar
      .title-bar-text
        img(src='assets/icon.svg' alt='' width='16' height='16')
        | #{title}
      .title-bar-controls
        button#help-button(type='button' aria-label='Help')
    .window-body
      block
    .status-bar
      p.status-bar-field= status
      p.status-bar-field wizard
